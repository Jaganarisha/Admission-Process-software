# ---- Server ----
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
ACADEMIC_YEAR=2026-27

# ---- Database (PostgreSQL / Amazon RDS) ----
DATABASE_URL=postgres://postgres:postgres@localhost:5432/admission_db
DB_SSL=false            # set true on Amazon RDS

# ---- Auth ----
# generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=8h

# ---- Document storage ----
# Leave S3_BUCKET empty in development -> files are stored in backend/uploads.
# On AWS set the bucket + region. Credentials come from the EC2/Elastic Beanstalk IAM role (never put keys here).
S3_BUCKET=
AWS_REGION=ap-south-1

# ---- Email notifications (optional; if SMTP_HOST is empty emails are only logged) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="BEC Admissions <admissions@bec.ac.in>"

# ---- Seed accounts (used only by npm run db:seed-users) ----
SEED_ADMIN_PASSWORD=Admin@12345
SEED_OFFICER_PASSWORD=Officer@12345
SEED_STUDENT_PASSWORD=Student@12345
